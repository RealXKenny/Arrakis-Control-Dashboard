{
  "name": "Arrakis-Control-Dashboard",
  "version": "1.20.4",
  "scripts": {
    "dev": "node src/config/server-launcher.mjs dev",
    "build": "next build",
    "start": "node src/config/server-launcher.mjs start",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:production": "node tests/smoke-production.mjs",
    "test:browser": "playwright test",
    "format": "prettier --write src tests",
    "format:check": "prettier --check src tests"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/saira": "^5.3.0",
    "@fontsource/saira-condensed": "^5.3.0",
    "dotenv": "^17.4.2",
    "ioredis": "^5.11.1",
    "next": "^16.3.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "redis": "^6.2.1",
    "three": "^0.186.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "26.4.1",
    "@types/react": "19.2.18",
    "@types/three": "^0.186.0",
    "@vitest/coverage-v8": "^5.0.0",
    "draco3dgltf": "^1.5.9",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.4",
    "prettier": "^3.9.6",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^5.0.0"
  }
}
