{
  "name": "Arrakis-Control-Dashboard",
  "version": "1.0.3",
  "scripts": {
    "dev": "node scripts/run-next.mjs dev",
    "build": "next build",
    "start": "node scripts/run-next.mjs start",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:production": "node scripts/smoke-production.mjs",
    "test:browser": "playwright test",
    "format": "prettier --write src tests",
    "format:check": "prettier --check src tests",
    "prebuild": "node scripts/generate-item-images.mjs",
    "predev": "node scripts/generate-item-images.mjs"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/saira": "^5.3.0",
    "@fontsource/saira-condensed": "^5.3.0",
    "@sentry/nextjs": "^10.73.0",
    "@upstash/redis": "^1.38.4",
    "dotenv": "^17.4.2",
    "next": "^16.3.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "26.4.1",
    "@types/react": "19.2.18",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.4",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "vitest": "^5.0.0"
  }
}
