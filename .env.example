# ============================================================================
# ARRAKIS CONTROL • ENVIRONMENT TEMPLATE
# Copy this file to .env and replace every placeholder before starting.
# Never commit your real .env file or any token/password.
# ============================================================================

# ----------------------------------------------------------------------------
# DASHBOARD SERVER
# ----------------------------------------------------------------------------
DASHBOARD_HOSTNAME=127.0.0.1
DASHBOARD_PORT=2008

# ============================================================================

# ----------------------------------------------------------------------------
# DUNE CONSOLE CONNECTION
# ----------------------------------------------------------------------------
CONSOLE_URL=http://your-console-host:port
CONSOLE_PASSWORD=replace_with_console_password
ADAPTER_TOKEN=replace_with_adapter_token

# ----------------------------------------------------------------------------
# Discord OAuth
# ----------------------------------------------------------------------------
DISCORD_CLIENT_ID=replace_with_discord_oauth_client_id
DISCORD_CLIENT_SECRET=replace_with_discord_oauth_client_secret
DISCORD_GUILD_ID=replace_with_discord_guild_id
DISCORD_REDIRECT_URI=http://your-ip:port/auth/callback
DISCORD_APP_URL=http://your-ip:port/
APP_URL=http://your-ip:port/
VERIFIED_MEMBER_ROLE_ID=replace_with_verified_member_role_id

# ----------------------------------------------------------------------------
# SHARED REDIS STORAGE (REQUIRED IN PRODUCTION)
# ----------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace_with_upstash_rest_token

# ----------------------------------------------------------------------------
# OPTIONAL MONITORING
# ----------------------------------------------------------------------------
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
# Set to true to enable Sentry outside production.
SENTRY_ENABLED=false

