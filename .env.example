# ============================================================================
# ARRAKIS CONTROL • ENVIRONMENT TEMPLATE
# Copy this file to .env and replace required placeholders before starting.
# Optional integrations may remain blank and disabled.
# Never commit your real .env file or any token/password.
# ============================================================================

# ----------------------------------------------------------------------------
# DASHBOARD SERVER
# ----------------------------------------------------------------------------
LOG_LEVEL=INFO
# Address used by both `npm run dev` and `npm start`.
SERVER_HOSTNAME=127.0.0.1
SERVER_PORT=2008
# Per-worker API admission budget; overload receives 503 with Retry-After.
API_MAX_CONCURRENCY=100
# Shared Redis limit per read route per minute. Increase only after deployment load tests.
API_GLOBAL_READ_LIMIT=2400
# Optional separate credential for the read-only Discord bot API (32–256 characters).
# Generate independently; never reuse Discord, Console, or adapter credentials.
BOT_API_TOKEN=

# ----------------------------------------------------------------------------
# DUNE CONSOLE CONNECTION
# ----------------------------------------------------------------------------
CONSOLE_URL=http://your-console-host:3000
CONSOLE_API_KEY=replace_with_scoped_console_api_key
# Optional separate elevated key for the administrator workspace. Never sent to browsers.
ADMIN_CONSOLE_API_KEY=
ADAPTER_TOKEN=replace_with_adapter_token

# ----------------------------------------------------------------------------
# Discord OAuth
# ----------------------------------------------------------------------------
DISCORD_CLIENT_ID=replace_with_discord_oauth_client_id
DISCORD_CLIENT_SECRET=replace_with_discord_oauth_client_secret
DISCORD_GUILD_ID=replace_with_discord_guild_id
APP_URL=https://portal.example.com/
# Signs sessions and encrypts stored Discord refresh tokens. Generate with: openssl rand -base64 48
AUTH_SECRET=replace_with_at_least_32_random_characters
VERIFIED_MEMBER_ROLE_ID=replace_with_verified_member_role_id

# ----------------------------------------------------------------------------
# SHARED REDIS STORAGE
# ----------------------------------------------------------------------------
# Use the Redis allocation host/port reachable from the dashboard container.
# Percent-encode special characters in credentials. Use rediss:// only for TLS.
REDIS_URL=redis://default:replace_with_redis_password@your-redis-host:6379/0
# Optional Redis Cluster bootstrap: comma-separated host:port list. When set,
# every Redis consumer uses ioredis Cluster (automatic failover) instead of the
# single REDIS_URL node; REDIS_URL still supplies credentials/TLS.
# Existing deployments must run `npm run redis:rekey` first (see README).
REDIS_CLUSTER_NODES=

# ----------------------------------------------------------------------------
# DISCORD CHANGELOG ANNOUNCEMENTS (optional)
# ----------------------------------------------------------------------------
# Channel webhook that receives release notes and progress updates with link buttons.
# Treat it as a secret: anyone holding the URL can post to the channel.
CHANGELOG_WEBHOOK_URL=
# Set to true to announce each newly deployed release once, automatically.
# The first run only records the current release, so old history is never replayed.
CHANGELOG_AUTO_ANNOUNCE=false

# ----------------------------------------------------------------------------
# REVERSE PROXY
# ----------------------------------------------------------------------------
# Number of reverse proxies in front of the dashboard (the deployment guide assumes one).
# Rate limits trust only the X-Forwarded-For entry the last proxy appended, so a client cannot
# pick its own address with a forged header. Use 0 when the dashboard is exposed directly.
TRUSTED_PROXY_COUNT=1
