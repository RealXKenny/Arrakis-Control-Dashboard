# ============================================================================
# ARRAKIS CONTROL • ENVIRONMENT TEMPLATE
# Copy this file to .env and replace required placeholders before starting.
# Optional integrations may remain blank and disabled.
# Never commit your real .env file or any token/password.
# ============================================================================

# ----------------------------------------------------------------------------
# DASHBOARD SERVER
# ----------------------------------------------------------------------------
DASHBOARD_HOSTNAME=127.0.0.1
DASHBOARD_PORT=2008
LOG_LEVEL=INFO

# ----------------------------------------------------------------------------
# DUNE CONSOLE CONNECTION
# ----------------------------------------------------------------------------
CONSOLE_URL=http://your-console-host:3000
CONSOLE_API_KEY=replace_with_full_access_console_api_key
ADAPTER_TOKEN=replace_with_adapter_token

# ----------------------------------------------------------------------------
# Discord OAuth
# ----------------------------------------------------------------------------
DISCORD_CLIENT_ID=replace_with_discord_oauth_client_id
DISCORD_CLIENT_SECRET=replace_with_discord_oauth_client_secret
DISCORD_GUILD_ID=replace_with_discord_guild_id
DISCORD_REDIRECT_URI=https://portal.example.com/auth/callback
DISCORD_APP_URL=https://portal.example.com/
APP_URL=https://portal.example.com/
VERIFIED_MEMBER_ROLE_ID=replace_with_verified_member_role_id

# ----------------------------------------------------------------------------
# SHARED STORAGE (choose redis or postgres)
# ----------------------------------------------------------------------------
STORAGE_BACKEND=redis
# Use the Redis allocation host/port reachable from the dashboard container.
# Percent-encode special characters in credentials. Use rediss:// only for TLS.
REDIS_URL=redis://default:replace_with_redis_password@your-redis-host:6379/0
# To use PostgreSQL without Redis, set STORAGE_BACKEND=postgres and DATABASE_URL.
DATABASE_URL=
DATABASE_SSL_MODE=require

# ----------------------------------------------------------------------------
# PUBLIC WEBSITE BRANDING AND FEATURES
# ----------------------------------------------------------------------------
SITE_NAME=Crimson Skies
SITE_TITLE=Arrakis Control Dashboard
SITE_SUBTITLE=Arrakis field companion
SITE_DESCRIPTION=Your Dune: Awakening character, holdings, live map and CHOAM market.
SITE_HERO_EYEBROW=Your field companion for Arrakis
SITE_HERO_TITLE=Know the sand.
SITE_HERO_ACCENT=Own your signal.
SITE_HERO_DESCRIPTION=A clear view of your character, territory, fleet, and the world around you—so every step into the desert starts with better intelligence.
SITE_COMMUNITY_TITLE=Find your crew before you find the spice.
SITE_COMMUNITY_DESCRIPTION=Join the conversation, share your next run, and stay close to the people shaping life across Arrakis.
SITE_FOOTER=Explore. Prepare. Endure.
SITE_DISCORD_INVITE_URL=https://discord.gg/crimsonskies
SITE_DISCORD_WIDGET_GUILD_ID=1532230917249302588
SITE_DISCORD_WIDGET_ENABLED=true
SITE_DEFAULT_MAP=HaggaBasin
# Optional discovered key such as sietch:HaggaBasin:101 or deep-desert:DeepDesert:dd-1
SITE_DEFAULT_DESTINATION=
SITE_HAGGA_LABEL=Hagga Basin
SITE_DEEP_DESERT_LABEL=Deep Desert
SITE_THEME_TEXT="#ffe2a9"
SITE_THEME_MUTED="#b9a185"
SITE_THEME_ACCENT="#d2a85a"
SITE_THEME_BORDER="#503521"
SITE_THEME_BACKGROUND="#100905"
SITE_THEME_SURFACE="#54321b"
SITE_FEATURE_MARKET=true
SITE_FEATURE_MAPS=true
SITE_FEATURE_GUILDS=true
SITE_FEATURE_BASES=true
SITE_FEATURE_VEHICLES=true
SITE_FEATURE_POPULATION=true
SITE_FEATURE_BASE_IMPORTS=true
SITE_POLL_INTERVAL_MS=30000
SITE_REQUEST_TIMEOUT_MS=30000

# ----------------------------------------------------------------------------
# STORAGE, SECURITY, AND RETENTION LIMITS
# ----------------------------------------------------------------------------
SESSION_TTL_SECONDS=43200
POPULATION_RETENTION_SECONDS=172800
BASE_IMPORT_DAILY_LIMIT=10
GUILD_LOGO_MAX_BYTES=524288

# ----------------------------------------------------------------------------
# OPTIONAL MONITORING
# ----------------------------------------------------------------------------
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_ENABLED=false
POPULATION_HISTORY_ENABLED=true
API_DEBUG_ENABLED=false