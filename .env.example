# ============================================================================
# ARRAKIS CONTROL • ENVIRONMENT TEMPLATE
# Copy this file to .env and replace required placeholders before starting.
# Optional integrations may remain blank and disabled.
# Never commit your real .env file or any token/password.
# ============================================================================

# ----------------------------------------------------------------------------
# DASHBOARD SERVER
# ----------------------------------------------------------------------------
DASHBOARD_HOSTNAME=127.0.0.1
DASHBOARD_PORT=2008
LOG_LEVEL=INFO
# In Docker, bind to 0.0.0.0 and publish only to your reverse proxy/private network.

# ----------------------------------------------------------------------------
# DUNE CONSOLE CONNECTION
# ----------------------------------------------------------------------------
CONSOLE_URL=http://your-console-host:3000
# Replace the hostname and example port with your actual Console address.
CONSOLE_PASSWORD=replace_with_console_password
ADAPTER_TOKEN=replace_with_adapter_token

# ----------------------------------------------------------------------------
# Discord OAuth
# ----------------------------------------------------------------------------
DISCORD_CLIENT_ID=replace_with_discord_oauth_client_id
DISCORD_CLIENT_SECRET=replace_with_discord_oauth_client_secret
DISCORD_GUILD_ID=replace_with_discord_guild_id
DISCORD_REDIRECT_URI=https://portal.example.com/auth/callback
DISCORD_APP_URL=https://portal.example.com/
APP_URL=https://portal.example.com/
# Replace portal.example.com with your public HTTPS domain. The redirect URI
# must exactly match the callback registered in the Discord Developer Portal.
VERIFIED_MEMBER_ROLE_ID=replace_with_verified_member_role_id

# ----------------------------------------------------------------------------
# SHARED REDIS STORAGE (REQUIRED IN PRODUCTION)
# ----------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace_with_upstash_rest_token

# ----------------------------------------------------------------------------
# OPTIONAL MONITORING
# ----------------------------------------------------------------------------
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
# Set to true to enable Sentry outside production.
SENTRY_ENABLED=false

# Record aggregate population every minute on a continuously running Node server.
# Requires a reachable Redis connection. Disable for isolated previews/tests.
POPULATION_HISTORY_ENABLED=true

# ----------------------------------------------------------------------------
# OPTIONAL RABBITMQ LIVE INTEL (CONTINUOUS NODE SERVER + REDIS REQUIRED)
# ----------------------------------------------------------------------------
# Leave disabled until broker connectivity, TLS and observer permissions are ready.
# All these values are SERVER-ONLY. Never prefix them with NEXT_PUBLIC_.
LIVE_EVENTS_ENABLED=false
RABBITMQ_URL=
RABBITMQ_MANAGEMENT_URL=
RABBITMQ_CA_PEM=
RABBITMQ_TLS_SERVERNAME=
LIVE_EVENTS_ADMIN_ROLE_IDS=

# SAME VPS, SHARED NETWORK NAMESPACE (separate Docker containers do NOT share localhost):
# RABBITMQ_URL=amqps://observer:URL_ENCODED_PASSWORD@127.0.0.1:5672/%2F
# RABBITMQ_MANAGEMENT_URL=http://127.0.0.1:15672
# RABBITMQ_TLS_SERVERNAME=broker-name-on-certificate

# WEBSITE ON ANOTHER MACHINE (private network/VPN):
# RABBITMQ_URL=amqps://observer:URL_ENCODED_PASSWORD@dune-private.example:5672/%2F
# RABBITMQ_MANAGEMENT_URL=https://rabbitmq-management.private.example
# Management HTTPS proxies to the broker's HTTP port 15672; restrict access to
# the website host. An SSH tunnel to loopback management is also supported.
# Dune uses TLS on 5672, NOT plaintext AMQP. %2F selects the default '/' vhost.
# URL-encode username/password separately; use a dedicated observer account.

# Optional private CA for AMQP, using escaped newlines in a double-quoted value:
# RABBITMQ_CA_PEM="-----BEGIN CERTIFICATE-----\nREPLACE_WITH_CA\n-----END CERTIFICATE-----"
# RABBITMQ_TLS_SERVERNAME must match the broker certificate if connecting by IP.
# Management HTTPS must be trusted by Node separately. If using a private CA,
# set NODE_EXTRA_CA_CERTS=/absolute/path/to/management-ca.pem in the process or
# container environment BEFORE Node starts (putting it in .env is too late).
# Never disable TLS verification or expose management publicly.

# Comma-separated numeric Discord ADMIN role IDs, without spaces:
# LIVE_EVENTS_ADMIN_ROLE_IDS=123456789012345678,234567890123456789
# Empty means no chat/player-activity access. Members see instance readings only.
# Sign in again after changing Discord roles to refresh the session role snapshot.

# Overnight: run under your existing container/process supervisor with restart
# enabled; verify Redis is reachable and Live Intel says 'Collector connected'.
# Retention is at most 24h / 500 events per kind, NOT a complete overnight archive.
# Reconnects and queue limits can lose messages. See docs/LIVE_INTEL.md.
