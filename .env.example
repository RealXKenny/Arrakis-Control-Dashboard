# ╭────────────────────────────────────────────────────────────────╮
# │            ARRAKIS CONTROL • ENVIRONMENT CONFIGURATION         │
# ├────────────────────────────────────────────────────────────────┤
# │ Copy this file to .env and configure required variables.       │
# │ Optional integrations may remain blank and disabled.           │
# │ Never commit your real .env file, tokens, or passwords.        │
# ╰────────────────────────────────────────────────────────────────╯

# ╭────────────────────────────────────────────────────────────────╮
# │ DASHBOARD SERVER                                               │
# ╰────────────────────────────────────────────────────────────────╯

LOG_LEVEL=INFO

# Address used by both `npm run dev` and `npm start`.
SERVER_HOSTNAME=0.0.0.0
SERVER_PORT=2008

# Per-worker API admission budget.
# Overloaded requests receive HTTP 503 with Retry-After.
API_MAX_CONCURRENCY=100

# Shared Redis limit per read route per minute.
# Increase only after deployment load testing.
API_GLOBAL_READ_LIMIT=2400

# Optional separate credential for the read-only Discord bot API.
# Must contain 32–256 characters.
# Generate independently; never reuse Discord, Console, or adapter credentials.
BOT_API_TOKEN=


# ╭────────────────────────────────────────────────────────────────╮
# │ DUNE CONSOLE CONNECTION                                        │
# ╰────────────────────────────────────────────────────────────────╯

CONSOLE_URL=http://your-console-host:3000
CONSOLE_API_KEY=replace_with_scoped_console_api_key

# Optional elevated key for the administrator workspace.
# This credential must never be exposed to browsers.
ADMIN_CONSOLE_API_KEY=

ADAPTER_TOKEN=replace_with_adapter_token


# ╭────────────────────────────────────────────────────────────────╮
# │ DISCORD OAUTH                                                  │
# ╰────────────────────────────────────────────────────────────────╯

DISCORD_CLIENT_ID=replace_with_discord_oauth_client_id
DISCORD_CLIENT_SECRET=replace_with_discord_oauth_client_secret
DISCORD_GUILD_ID=replace_with_discord_guild_id

# Public-facing dashboard URL.
APP_URL=https://portal.example.com/

# Signs sessions and encrypts stored Discord refresh tokens.
# Generate a secure secret using: openssl rand -base64 48
AUTH_SECRET=replace_with_at_least_32_random_characters

VERIFIED_MEMBER_ROLE_ID=replace_with_verified_member_role_id


# ╭────────────────────────────────────────────────────────────────╮
# │ SHARED REDIS STORAGE                                           │
# ╰────────────────────────────────────────────────────────────────╯

# Use the Redis allocation host and port reachable from the dashboard.
# Percent-encode special characters in credentials.
# Use rediss:// only when TLS is enabled.
REDIS_URL=redis://default:replace_with_redis_password@your-redis-host:6379/0

# Optional Redis Cluster bootstrap configuration.
# Supply a comma-separated list of host:port entries.
#
# When configured, every Redis consumer uses ioredis Cluster with
# automatic failover instead of the standalone REDIS_URL connection.
#
# REDIS_URL continues to provide authentication and TLS settings.
#
# IMPORTANT:
# Existing deployments must run `npm run redis:rekey` first.
# See README for migration instructions.
REDIS_CLUSTER_NODES=

# Set to true to make production refuse to start unless REDIS_URL uses rediss:// (TLS).
# Off by default so existing plain-text deployments keep working; enable it once Redis offers TLS.
REDIS_REQUIRE_TLS=false

# ╭────────────────────────────────────────────────────────────────╮
# │ CASINO (OPTIONAL)                                              │
# ╰────────────────────────────────────────────────────────────────╯

# Solaris Exchange (casino). Every table wagers REAL in-game Solaris, so this stays false until legal, publisher-policy
# and age/access requirements are confirmed and the Console's transfer behaviour is verified on a test server.
# While false the server refuses every deposit, withdrawal and wager.
CASINO_SOLARIS_ENABLED=false
# Largest single wager and largest payout of one round, in whole Solaris.
CASINO_MAX_WAGER=10000
CASINO_MAX_PAYOUT=1000000

# Reviewed season rewards use ADMIN_CONSOLE_API_KEY, independently of the casino.
# Enable only after verifying the Console contract on a disposable test character.
# Every delivery still requires separate admin approval and explicit execution.
SEASON_GAME_DELIVERY_ENABLED=false

# ╭────────────────────────────────────────────────────────────────╮
# │ LIVE GAME CHAT (OPTIONAL)                                      │
# ╰────────────────────────────────────────────────────────────────╯

# Uses the same game RabbitMQ broker and TextChat protocol as Arrakis Control Bot.
# npm start (or npm run dev) automatically supervises the Chat Bridge when enabled.
CHAT_ENABLED=false
RABBITMQ_URL=
CHAT_BRIDGE_FUNCOM_ID=
# Optional trusted Discord relay bot identity. Quote values containing #; both ID and [Discord]
# prefix must match. Genuine player messages remain Game even when they imitate the prefix.
CHAT_DISCORD_BOT_FUNCOM_ID=
# Leave blank to use the persona's native game name. Quote values containing # in dotenv.
CHAT_BRIDGE_DISPLAY_NAME=
# Unique dashboard destinations. Map values are exact, case-sensitive chat.map routing keys.
CHAT_SERVERS='[{"id":"hagga-basin","label":"Hagga Basin","map":"HaggaBasin.0"}]'
RABBITMQ_CA_FILE=
RABBITMQ_TLS_SERVERNAME=
# TLS follows the URL scheme when unset; true requires amqps://, false requires amqp://.
RABBITMQ_TLS_ENABLED=
# Inline PEM takes precedence over paths. Paste the complete certificate inside quotes;
# actual multiline values and literal \n escapes are both supported. No real certificates belong here.
RABBITMQ_TLS_CA=
# Optional mutual-TLS client identity; both certificate and private key are required together.
RABBITMQ_TLS_CERT=
RABBITMQ_TLS_KEY=
RABBITMQ_TLS_CA_PATH=
RABBITMQ_TLS_CERT_PATH=
RABBITMQ_TLS_KEY_PATH=
# Verification cannot be disabled. RABBITMQ_CA_FILE remains a legacy CA-path fallback.
RABBITMQ_TLS_REJECT_UNAUTHORIZED=true

# Legacy setting retained for compatibility; ignored. Receive queues are always broker-generated,
# exclusive amq.gen-* queues, matching the existing game-broker permissions.
CHAT_BRIDGE_QUEUE=arrakis.dashboard.chat.v1
CHAT_BRIDGE_PREFETCH=20
CHAT_BRIDGE_HEALTH_HOST=127.0.0.1
CHAT_BRIDGE_HEALTH_PORT=2010

# Recent history is kept in Redis Streams with exact count and age trimming.
CHAT_HISTORY_MAX_MESSAGES=10000
CHAT_HISTORY_RETENTION_DAYS=7
CHAT_MESSAGE_MAX_CHARS=1000

# Per-member and per-destination send limits within each shared window.
CHAT_SEND_RATE_LIMIT=10
CHAT_SERVER_SEND_RATE_LIMIT=60
CHAT_SEND_RATE_WINDOW_SECONDS=10


# ╭────────────────────────────────────────────────────────────────╮
# │ DISCORD CHANGELOG ANNOUNCEMENTS (OPTIONAL)                     │
# ╰────────────────────────────────────────────────────────────────╯

# Reuse the main Discord bot. Server-side REST only; no extra bot process.
# Keep the token secret and out of Git. Bot needs View Channel, Send Messages,
# and Read Message History in these text/announcement channels.
DISCORD_BOT_TOKEN=
CHANGELOG_CHANNEL_ID=
COMMUNITY_EVENTS_CHANNEL_ID=
# Published community events announce automatically and edit their existing post.

# Automatically announce each newly deployed release once.
#
# The initial run records the current release without announcing it.
# This prevents previously published releases from being replayed.
CHANGELOG_AUTO_ANNOUNCE=false


# ╭────────────────────────────────────────────────────────────────╮
# │ REVERSE PROXY                                                  │
# ╰────────────────────────────────────────────────────────────────╯

# Number of trusted reverse proxies in front of the dashboard.
# The standard deployment configuration assumes one proxy.
#
# Rate limiting trusts only the X-Forwarded-For entry appended
# by the last trusted proxy, preventing clients from selecting
# their own IP address through forged forwarding headers.
#
# Set to 0 when the dashboard is exposed directly.
TRUSTED_PROXY_COUNT=1

# ╭────────────────────────────────────────────────────────────────╮
# │ ADMINISTRATOR WORKSPACE                                        │
# ╰────────────────────────────────────────────────────────────────╯

# Comma-separated Discord user IDs allowed to use /admin.
# REQUIRED in production: startup refuses to run without it, and no built-in administrator exists there.
# Local development (NODE_ENV not production) falls back to the project owner when blank.
ADMIN_DISCORD_IDS=

# Administrator changes need an interactive sign-in within this many hours
# (1-168). Viewing is unaffected; sessions older than this sign in once more.
ADMIN_REAUTH_HOURS=12

# ╭────────────────────────────────────────────────────────────────╮
# │ SECURITY HARDENING (OPTIONAL)                                  │
# ╰────────────────────────────────────────────────────────────────╯

# Dedicated server-only secret (32+ characters) for marketplace owner identifiers.
# When empty, one is derived from AUTH_SECRET. Generate with: openssl rand -base64 48
# Changing it later orphans ownership of listings published under the old value.
OWNER_KEY_SECRET=

# Only for `npm run marketplace:rekey` (the dashboard itself never reads it): after rotating OWNER_KEY_SECRET, put the
# OLD value here and re-run the command so already-migrated listings keep their owners. Leave empty otherwise.
OWNER_KEY_PREVIOUS_SECRET=

# Destructive administrator actions (deletes, confirmed actions, archive downloads) need an interactive sign-in this
# recent, in minutes (5-1440). Ordinary administrator changes use ADMIN_REAUTH_HOURS above.
ADMIN_HIGH_RISK_REAUTH_MINUTES=60

# Security audit trail: JSON lines on stdout (prefixed "AUDIT ") for log shipping, plus a bounded Redis sorted set
# readable by administrators at /api/v2/admin/audit. Entries never contain credentials, cookies or request bodies.
AUDIT_LOG_STDOUT=true
AUDIT_LOG_REDIS=true
AUDIT_LOG_RETENTION_DAYS=90
AUDIT_LOG_MAX_ENTRIES=10000

# Production refuses to start for plain-text Redis on a public-looking host with no password unless this is true.
REDIS_ALLOW_INSECURE=false
